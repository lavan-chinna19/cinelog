# ───────────── CineLog environment variables ─────────────
# Copy the relevant block into each app. NEVER commit real values.

# ── Web (apps/web/.env.local) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Mobile (apps/mobile/.env) ──
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── TMDB (server-side only, never NEXT_PUBLIC_) ──
# Web: set in Vercel (Project → Settings → Environment Variables) or apps/web/.env.local.
# Read by apps/web/src/app/api/tmdb/route.ts. One of the two is enough; the token is preferred.
API_Read_Access_Token=your-tmdb-api-read-access-token
API_Key=your-tmdb-v3-api-key
# Optional: the Supabase Edge Function 'tmdb' reads the same names from
#   supabase secrets set API_Read_Access_Token=...
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# into Edge Functions automatically — never put the service-role key in an app.
